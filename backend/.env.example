# FastAPI environment
APP_ENV=development

# Supabase-managed PostgreSQL. Use the connection string from the Supabase
# dashboard; never commit the real value.
DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@[HOST]:5432/postgres

# Optional: needed only if this API validates Supabase Auth tokens or calls
# Supabase services. Keep server-only keys out of the frontend.
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_AUDIENCE=authenticated
