SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key
# Required by the Flask API for explicitly authorized server-side data access.
# Keep this key in backend/.env or the server's secret manager; never expose it
# through Vite, a frontend environment variable, or a client response.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
